#!/usr/bin/env bash
#MISE description="Install or check codebase pre-commit hook"
#USAGE flag "--revert" help="Remove the codebase pre-commit hook"
#USAGE flag "--check" help="Check if hook is installed and current (no changes)"
#USAGE example "codebase pre-commit" header="Install or refresh the hook"
#USAGE example "codebase pre-commit --check" header="Check without changing the hook"
#USAGE example "codebase pre-commit --revert" header="Remove the hook"

set -euo pipefail

# shellcheck source=../../lib/codebase-config.sh
source "$MISE_CONFIG_ROOT/lib/codebase-config.sh"

REVERT="${usage_revert:-false}"
CHECK="${usage_check:-false}"

# Find repo root — use CODEBASE_CALLER_PWD (set by shiv) if available,
# otherwise fall back to legacy CALLER_PWD during migration and then current directory.
CALLER="${CODEBASE_CALLER_PWD:-${CALLER_PWD:-$(pwd)}}"
if ! REPO_ROOT=$(codebase_git_root "$CALLER"); then
  REPO_ROOT=""
fi
if [[ -z "$REPO_ROOT" ]]; then
  echo "ERROR: not in a git repository" >&2
  exit 1
fi

TOML="$REPO_ROOT/mise.toml"
HOOK="$REPO_ROOT/.git/hooks/pre-commit"
HOOK_DIR="$REPO_ROOT/.git/hooks/pre-commit.d"
CODEBASE_HOOK="$HOOK_DIR/codebase"

# --- Revert ---
if [[ "$REVERT" == "true" ]]; then
  if [[ ! -f "$CODEBASE_HOOK" ]]; then
    echo "No codebase hook installed"
    exit 0
  fi

  rm "$CODEBASE_HOOK"
  echo "Removed codebase hook"

  # Clean up empty dispatcher
  if [[ -d "$HOOK_DIR" ]] && [[ -z "$(ls -A "$HOOK_DIR")" ]]; then
    rmdir "$HOOK_DIR"
    if [[ -f "$HOOK" ]] && grep -q "pre-commit.d" "$HOOK"; then
      rm "$HOOK"
      echo "Removed empty pre-commit dispatcher"
    fi
  fi
  exit 0
fi

# --- Validate config ---
if [[ ! -f "$TOML" ]]; then
  [[ "$CHECK" == "true" ]] && exit 1
  echo "ERROR: no mise.toml found" >&2
  exit 1
fi

RULES=()
while IFS= read -r rule; do
  [[ -n "$rule" ]] && RULES+=("$rule")
done < <(codebase_configured_lint_rules "$REPO_ROOT")

if [[ ${#RULES[@]} -eq 0 ]]; then
  [[ "$CHECK" == "true" ]] && exit 1
  echo "ERROR: no lint rules configured in $TOML" >&2
  echo "Add to mise.toml:" >&2
  echo '  [_.codebase]' >&2
  echo '  lint = ["mise-settings", "gum-table"]' >&2
  exit 1
fi

# --- Generate hook content ---
NEW_HOOK=$(cat <<'HOOK'
#!/usr/bin/env bash
# Auto-generated by: codebase pre-commit
# Delegates to the aggregate lint entrypoint through this repository's Mise environment.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
if ! command -v mise >/dev/null 2>&1; then
  echo "ERROR: mise is required to run the repository-selected Codebase" >&2
  exit 1
fi
exec mise -C "$REPO_ROOT" exec -- codebase lint "$REPO_ROOT"
HOOK
)

# --- Check mode ---
if [[ "$CHECK" == "true" ]]; then
  if [[ -f "$CODEBASE_HOOK" ]] && [[ "$(cat "$CODEBASE_HOOK")" == "$NEW_HOOK" ]]; then
    exit 0
  else
    exit 1
  fi
fi

# --- Install dispatcher if missing ---
if [[ -f "$HOOK" ]] && ! grep -q "pre-commit.d" "$HOOK"; then
  echo "ERROR: existing pre-commit hook is not a dispatcher" >&2
  echo "Move it to .git/hooks/pre-commit.d/ manually, then re-run." >&2
  exit 1
fi

if [[ ! -f "$HOOK" ]]; then
  mkdir -p "$HOOK_DIR"
  cat > "$HOOK" <<'DISPATCHER'
#!/usr/bin/env bash
# Pre-commit dispatcher — runs all executable scripts in pre-commit.d/
set -eo pipefail
HOOK_DIR="$(dirname "$0")/pre-commit.d"
for hook in "$HOOK_DIR"/*; do
  [ -x "$hook" ] && "$hook" || exit $?
done
DISPATCHER
  chmod +x "$HOOK"
else
  mkdir -p "$HOOK_DIR"
fi

# --- Write if changed ---
if [[ -f "$CODEBASE_HOOK" ]] && [[ "$(cat "$CODEBASE_HOOK")" == "$NEW_HOOK" ]]; then
  echo "pre-commit hook up to date"
else
  echo "$NEW_HOOK" > "$CODEBASE_HOOK"
  chmod +x "$CODEBASE_HOOK"
  echo "Installed pre-commit hook"
fi
