#!/usr/bin/env bash
#MISE description="Lint GitHub Actions workflows and create a KKL default workflow when missing"
#USAGE arg "<targets>…" help="Paths to codebases to check (one or more)"
#USAGE flag "--fix" help="Create a default GitHub Actions workflow when missing"

set -euo pipefail

# shellcheck source=../../../lib/codebase-config.sh
source "$MISE_CONFIG_ROOT/lib/codebase-config.sh"

FIX="${usage_fix:-false}"

IFS=' ' read -ra TARGETS <<< "${usage_targets}"

if [[ ${#TARGETS[@]} -eq 0 ]]; then
  echo "ERROR: at least one target is required" >&2
  exit 1
fi

# Resolve relative paths against CALLER_PWD (see lib/shell-files.sh).
for i in "${!TARGETS[@]}"; do
  TARGETS[i]=$(resolve_target "${TARGETS[i]}")
done

if ! command -v actionlint >/dev/null 2>&1; then
  echo "ERROR: actionlint not found on PATH" >&2
  exit 127
fi

has_test_task() {
  local target="$1"
  [[ -f "$target/.mise/tasks/test" || -f "$target/.mise/tasks/test/_default" ]]
}

section_has_key() {
  local toml="$1"
  local section="$2"
  local key_pattern="$3"

  awk -v section="$section" -v key_pattern="$key_pattern" '
    $0 ~ "^[[:space:]]*\\[" section "\\][[:space:]]*$" { in_section=1; next }
    /^[[:space:]]*\[/ { in_section=0 }
    in_section && $0 ~ key_pattern { found=1 }
    END { exit found ? 0 : 1 }
  ' "$toml"
}

ensure_section_key() {
  local toml="$1"
  local section="$2"
  local key_line="$3"
  local tmp

  if ! grep -q "^[[:space:]]*\[$section\][[:space:]]*$" "$toml"; then
    printf '\n[%s]\n%s\n' "$section" "$key_line" >> "$toml"
    return 0
  fi

  tmp=$(mktemp)
  awk -v section="$section" -v key_line="$key_line" '
    {
      print
      if (!inserted && $0 ~ "^[[:space:]]*\\[" section "\\][[:space:]]*$") {
        print key_line
        inserted=1
      }
    }
  ' "$toml" > "$tmp"
  mv "$tmp" "$toml"
}

ensure_codebase_tooling() {
  local target="$1"
  local toml="$target/mise.toml"
  local added=()
  local tmp

  [[ -f "$toml" ]] || return 0

  if ! section_has_key "$toml" "plugins" '^[[:space:]]*shiv[[:space:]]*='; then
    ensure_section_key "$toml" "plugins" 'shiv = "https://github.com/KnickKnackLabs/vfox-shiv"'
    added+=("shiv plugin")
  fi

  if ! section_has_key "$toml" "tools" '^[[:space:]]*"shiv:codebase"[[:space:]]*='; then
    ensure_section_key "$toml" "tools" '"shiv:codebase" = "latest"'
    added+=("shiv:codebase tool")
  elif ! awk '
    /^\[tools\][[:space:]]*$/ { in_tools=1; next }
    /^\[/ { in_tools=0 }
    in_tools && /^[[:space:]]*"shiv:codebase"[[:space:]]*=/ && $0 ~ /"latest"/ { found=1 }
    END { exit found ? 0 : 1 }
  ' "$toml"; then
    tmp=$(mktemp)
    awk '
      /^\[tools\][[:space:]]*$/ { in_tools=1; print; next }
      /^\[/ { in_tools=0 }
      in_tools && /^[[:space:]]*"shiv:codebase"[[:space:]]*=/ {
        print "\"shiv:codebase\" = \"latest\""
        next
      }
      { print }
    ' "$toml" > "$tmp"
    mv "$tmp" "$toml"
    added+=("shiv:codebase tool -> latest")
  fi

  if [[ ${#added[@]} -gt 0 ]]; then
    echo "FIX   $(basename "$target"): added ${added[*]}"
  fi
}

collect_workflows() {
  local target="$1"
  local workflows_dir="$target/.github/workflows"

  [[ -d "$workflows_dir" ]] || return 0

  find "$workflows_dir" -type f \( -name "*.yml" -o -name "*.yaml" \) 2>/dev/null | LC_ALL=C sort
}

write_default_workflow() {
  local target="$1"
  local workflow="$target/.github/workflows/test.yml"
  local lints
  lints=$(codebase_configured_lint_rules "$target")

  if ! has_test_task "$target" && [[ -z "$lints" ]]; then
    echo "FAIL  $(basename "$target"): no workflow found and no checks inferred (add .mise/tasks/test or [_.codebase].lint)"
    return 1
  fi

  mkdir -p "$(dirname "$workflow")"

  cat > "$workflow" <<'YAML'
name: Test

on:
  pull_request:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read

env:
  GH_TOKEN: ${{ github.token }}
  GITHUB_TOKEN: ${{ github.token }}
  MISE_JOBS: 1

jobs:
  test:
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, macos-latest]
    runs-on: ${{ matrix.os }}

    steps:
      - uses: actions/checkout@v6

      - name: Set up mise
        uses: jdx/mise-action@v4
        with:
          install: true
YAML

  if has_test_task "$target"; then
    cat >> "$workflow" <<'YAML'

      - name: Run tests
        run: mise run test
YAML
  fi

  if [[ -n "$lints" ]]; then
    ensure_codebase_tooling "$target"

    cat >> "$workflow" <<'YAML'

      - name: Run codebase lints
        run: codebase lint "$PWD"
YAML
  fi

  echo "FIX   $(basename "$target"): created .github/workflows/test.yml"
}

failures=0

for target in "${TARGETS[@]}"; do
  if [[ ! -e "$target" ]]; then
    echo "ERROR: target does not exist: $target" >&2
    exit 1
  fi

  name=$(basename "$target")
  toml="$target/mise.toml"

  if [[ -f "$toml" ]] && grep -m1 -q 'codebase:ignore github-actions' "$toml"; then
    echo "SKIP  $name (codebase:ignore)"
    continue
  fi

  workflows=()
  while IFS= read -r workflow; do
    [[ -n "$workflow" ]] && workflows+=("$workflow")
  done < <(collect_workflows "$target")

  if [[ ${#workflows[@]} -eq 0 ]]; then
    if [[ "$FIX" == "true" ]]; then
      if ! write_default_workflow "$target"; then
        failures=$((failures + 1))
        continue
      fi
      workflows=("$target/.github/workflows/test.yml")
    else
      echo "FAIL  $name: no GitHub Actions workflows found"
      failures=$((failures + 1))
      continue
    fi
  fi

  if ! output=$(actionlint "${workflows[@]}" 2>&1); then  # codebase:ignore bash-empty-array-expansions -- guard ensures workflows non-empty
    count=$(printf '%s\n' "$output" | grep -cE '^[^:]+:[0-9]+:[0-9]+:' || true)  # codebase:ignore or-true — grep -c exits 1 on zero matches
    [[ "$count" -eq 0 ]] && count=1
    echo "FAIL  $name: $count GitHub Actions violation(s)"
    printf '%s\n' "$output" | sed 's/^/  /'
    failures=$((failures + 1))
  else
    echo "OK    $name (${#workflows[@]} workflow(s) valid)"
  fi
done

exit "$failures"
