#!/usr/bin/env bash
#MISE description="Run BATS test suite"
#USAGE arg "[args]" default="" var=#true help="Test suites, files, or BATS arguments"
#USAGE example "mise run test" header="Run all maintained tests"
#USAGE example "mise run test lint/bats-test-task" header="Run a suite directory by path"
#USAGE example "mise run test test/lint/or-true/or-true.bats" header="Run one test file"
#USAGE example "mise run test --filter rejects" header="Filter tests by name"
set -euo pipefail

TEST_DIR="$MISE_CONFIG_ROOT/test"

arguments=()
if [[ -n "${usage_args:-}" ]]; then
  while IFS= read -r argument; do
    [[ -z "$argument" ]] || arguments+=("$argument")
  done < <(printf '%s' "$usage_args" | xargs printf '%s\n')
fi

resolved=()
has_target=false
for argument in ${arguments[@]+"${arguments[@]}"}; do
  if [[ "$argument" != -* && -d "$TEST_DIR/$argument" ]]; then
    resolved+=("$TEST_DIR/$argument")
    has_target=true
  elif [[ "$argument" != -* && -f "$TEST_DIR/$argument.bats" ]]; then
    resolved+=("$TEST_DIR/$argument.bats")
    has_target=true
  else
    [[ "$argument" == *.bats || -d "$argument" ]] && has_target=true
    resolved+=("$argument")
  fi
done

if ! $has_target; then
  # Codebase's lint fixtures intentionally contain invalid .bats files.
  # Enumerate maintained tests instead of recursively executing fixtures.
  while IFS= read -r test_file; do
    resolved+=("$test_file")
  done < <(fd -t f -e bats --exclude fixtures . "$TEST_DIR" | LC_ALL=C sort)
fi

exec bats ${resolved[@]+"${resolved[@]}"}
